<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BaseActivity.Light.DarkActionBar" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- TermuxPP UI colors (termux-shared); the app theme and the accents override them. -->
        <item name="termuxUiPrimary">@color/termuxpp_ui_primary</item>
        <item name="termuxUiOnPrimary">@color/termuxpp_ui_on_primary</item>
        <item name="termuxUiContainer">@color/termuxpp_ui_container</item>
        <item name="termuxUiOnContainer">@color/termuxpp_ui_on_container</item>
        <item name="termuxUiRipple">@color/termuxpp_ui_ripple</item>
        <item name="termuxUiShelf">@color/termuxpp_ui_shelf</item>
        <item name="termuxUiSearch">@color/termuxpp_ui_search</item>
        <item name="termuxUiGroup">@color/termuxpp_ui_group</item>
        <item name="colorPrimary">@color/ui_primary</item>
        <item name="colorPrimaryVariant">@color/ui_primary</item>
        <item name="colorOnPrimary">@color/ui_on_primary</item>
        <item name="colorSecondary">@color/ui_primary</item>
        <item name="colorSecondaryVariant">@color/ui_primary</item>
        <item name="colorOnSecondary">@color/ui_on_primary</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_on_surface</item>
        <item name="android:colorBackground">@color/ui_surface</item>
        <item name="android:windowBackground">@color/ui_surface</item>
        <item name="android:textColorPrimary">@color/ui_on_surface</item>
        <item name="android:textColorSecondary">@color/ui_on_surface_variant</item>
        <item name="android:textColorLink">@color/ui_primary</item>
        <item name="colorControlHighlight">@color/ui_ripple</item>
        <item name="colorPrimaryDark">@color/ui_surface</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/ui_surface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/ui_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
    </style>
    <style name="Theme.BaseActivity.Light.NoActionBar" parent="Theme.BaseActivity.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
