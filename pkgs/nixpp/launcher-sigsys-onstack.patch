 // ---- the SIGSYS handler ------------------------------------------------
@@ -990,6 +996,23 @@
 // during it (zsh's SIGCHLD while it traps rt_sigprocmask) runs the
 // program's handler on top of ours, and a syscall trapped there with SIGSYS
 // blocked is force-killed (signal 31). With NODEFER it nests into ours.
+//
+// Programs whose runtime owns registers break when their handlers nest into
+// ours: Go keeps the current goroutine in x28 on arm64, which this C code
+// reuses, and its handlers (SIGURG preemption, SIGPROF) then read garbage
+// and crash without a trace. So the handler blocks every asynchronous signal
+// (SIGSYS_MASK); they are delivered once it returns, on top of the program's
+// own context. SIGSYS stays open (NODEFER), and so do the synchronous faults,
+// which a mask cannot defer anyway.
+// No SA_ONSTACK: the handler keeps 17-25 KiB of PATHBUF buffers on its
+// stack, more than Rust's alternate signal stacks hold (multi-threaded Rust
+// programs crashed). On the current stack it still overflows Go's small
+// goroutine stacks; that needs a stack of the handler's own.
+#define SIGBIT(s) (1ULL << ((s) - 1))
+#define SIGSYS_MASK                                                        \
+	(~0ULL & ~(SIGBIT(SIGSYS) | SIGBIT(SIGSEGV) | SIGBIT(SIGBUS) |    \
+		   SIGBIT(SIGILL) | SIGBIT(SIGFPE) | SIGBIT(SIGTRAP) |        \
+		   SIGBIT(SIGKILL) | SIGBIT(SIGSTOP)))
