+// ---- the handler's own stack ------------------------------------------
+//
+// Every thread that traps gets a private stack for the handler's work, mapped
+// on first use and kept for the thread's life: slots keyed by (pid, tid),
+// claimed with a compare-and-swap, and taken over from threads that no longer
+// exist. vfork children (shared memory) claim their own slot; a slot is only
+// reclaimed when tgkill says its thread is gone. Without a free slot the
+// handler runs on the current stack, as it always did.
+#define HSTACK_SIZE (512UL * 1024)
+#define HSTACK_GUARD 4096UL
+#define HSTACK_SLOTS 256
+struct hstack {
+	long tid; // 0: free
+	long pid;
+	char *base; // HSTACK_GUARD + HSTACK_SIZE, guard page first
+};
+static struct hstack g_hstacks[HSTACK_SLOTS];
+
+static char *hstack_top(struct hstack *slot)
+{
+	char *base = __atomic_load_n(&slot->base, __ATOMIC_ACQUIRE);
+	if (!base) {
+		long m = SYS6(SYS_mmap, 0, HSTACK_GUARD + HSTACK_SIZE, PROT_READ | PROT_WRITE,
+			      MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+		if (m < 0 && m > -4096)
+			return NULL;
+		SYS3(SYS_mprotect, m, HSTACK_GUARD, PROT_NONE);
+		base = (char *)m;
+		__atomic_store_n(&slot->base, base, __ATOMIC_RELEASE);
+	}
+	return base + HSTACK_GUARD + HSTACK_SIZE;
+}
+
+static char *handler_stack(void)
+{
+	long pid = SYS0(SYS_getpid), tid = SYS0(SYS_gettid);
+	for (int i = 0; i < HSTACK_SLOTS; i++)
+		if (__atomic_load_n(&g_hstacks[i].tid, __ATOMIC_ACQUIRE) == tid &&
+		    __atomic_load_n(&g_hstacks[i].pid, __ATOMIC_ACQUIRE) == pid)
+			return hstack_top(&g_hstacks[i]);
+	for (int pass = 0; pass < 2; pass++) {
+		for (int i = 0; i < HSTACK_SLOTS; i++) {
+			struct hstack *slot = &g_hstacks[i];
+			long owner = __atomic_load_n(&slot->tid, __ATOMIC_ACQUIRE);
+			if (owner != 0 &&
+			    (pass == 0 ||
+			     SYS3(SYS_tgkill, __atomic_load_n(&slot->pid, __ATOMIC_ACQUIRE), owner, 0) != -ESRCH))
+				continue;
+			if (!__atomic_compare_exchange_n(&slot->tid, &owner, tid, 0, __ATOMIC_ACQ_REL,
+							 __ATOMIC_ACQUIRE))
+				continue;
+			__atomic_store_n(&slot->pid, pid, __ATOMIC_RELEASE);
+			return hstack_top(slot);
+		}
+	}
+	return NULL;
+}
