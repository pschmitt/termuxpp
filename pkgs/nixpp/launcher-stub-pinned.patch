+// The range is an ABI between launcher versions: the filter of every
+// running process exempts exactly these addresses, and a newer launcher
+// exec'd from such a process runs under that filter. So it lives in its own
+// section, linked at a fixed address (see bootstrap-seed.nix), and must not
+// change size or layout.
+	.section .launcher_stub, "ax", %progbits
 	.balign 16
 	.globl allow_start, allow_end, raw_syscall6, sig_restorer, jump_to
 allow_start:
@@ -27,6 +32,9 @@
