#compdef tpp-session

local action word
local -a actions flags ids positions positional
if (( CURRENT == 2 ))
then
  actions=(
    'list:List terminal sessions'
    'close:Hang up or dismiss a session'
    'focus:Switch to a session'
    'kill:Force-stop a session shell'
    'move:Reorder a session'
    'rename:Change the session name'
    'reload-settings:Reload app properties and styling'
    'switcher:Open the session switcher'
    'completions:Print completion source'
    '--help:Show help'
  )
  _describe 'session command' actions
  return
fi
action=$words[2]
[[ $action == -h || $action == --help ]] && return 1
flags=(--json --help)
for word in "${(@)words[3,CURRENT-1]}"
do
  case $word in
    -h|--help) return 1 ;;
    --json) flags=(--help) ;;
    -*) ;;
    *) positional+=("$word") ;;
  esac
done
if [[ $PREFIX == -* ]]
then
  compadd - $flags
  return
fi
case $action in
  completions)
    (( ${#positional} == 0 )) && compadd - bash fish zsh
    ;;
  close|focus|kill|move|rename)
    if (( ${#positional} == 0 ))
    then
      ids=( "${(@f)$(tpp-session __complete ids)}" )
      (( ${#ids} )) && compadd -a ids
    elif [[ $action == move ]] && (( ${#positional} == 1 ))
    then
      positions=( "${(@f)$(tpp-session __complete positions)}" )
      (( ${#positions} )) && compadd -a positions
    fi
    ;;
esac
