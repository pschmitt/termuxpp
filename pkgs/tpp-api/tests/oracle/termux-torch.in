#!@TERMUX_PREFIX@/bin/sh
set -e -u

SCRIPTNAME="tpp torch"

show_usage () {
	echo "Usage: $SCRIPTNAME [on | off]"
	echo "Toggle LED Torch on device"
	exit "${1:-1}"
}

case "${1:-}" in
	-h|--help) show_usage 0 ;;
esac

if [ "$#" -ne 1 ]; then
	echo "Illegal param count"
	show_usage
fi

PARAMS=""

if [ "$1" = on ]; then
	PARAMS="--ez enabled true"
elif [ "$1" = off ]; then
	PARAMS="--ez enabled false"
else
	echo "Illegal parameter: $1"
	show_usage
fi

@TERMUX_PREFIX@/libexec/termux-api Torch $PARAMS
