#!@TERMUX_PREFIX@/bin/sh
set -e -u

SCRIPTNAME="tpp battery"
show_usage () {
    echo "Usage: $SCRIPTNAME [FIELD]"
    echo "Get the status of the device battery, or only one FIELD of it"
    echo "(for example plugged, percentage or status)."
    exit 0
}

while getopts :h option
do
    case "$option" in
        h) show_usage;;
        ?) echo "$SCRIPTNAME: illegal option -$OPTARG"; exit 1;
    esac
done
shift $((OPTIND-1))

if [ $# != 0 ]; then echo "$SCRIPTNAME: too many arguments"; exit 1; fi

@TERMUX_PREFIX@/libexec/termux-api BatteryStatus
