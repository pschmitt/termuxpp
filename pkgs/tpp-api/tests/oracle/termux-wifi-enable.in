#!@TERMUX_PREFIX@/bin/sh
set -e -u

show_usage () {
        echo "Usage: tpp wifi enable"
        echo "       tpp wifi disable"
        echo "Turn Wi-Fi on or off."
        exit "${1:-1}"
}

case "${1:-}" in
        -h|--help) show_usage 0 ;;
esac

if [ "$#" -ne 1 ]; then
        show_usage
fi

case $1 in
        true|false);;
        *) show_usage;;
esac

@TERMUX_PREFIX@/libexec/termux-api WifiEnable --ez enabled "$1"
