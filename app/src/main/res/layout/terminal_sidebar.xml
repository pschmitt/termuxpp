<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/ui_drawer_width"
    android:layout_height="match_parent"
    android:choiceMode="singleChoice"
    android:divider="@android:color/transparent"
    android:dividerHeight="0dp"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:visibility="invisible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/sidebar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/ui_drawer_title"
            android:textAppearance="@style/TextAppearance.TermuxPP.DrawerTitle"
            tools:targetApi="p" />

        <ImageButton
            android:id="@+id/settings_button"
            style="@style/Widget.TermuxPP.IconButton"
            android:layout_width="@dimen/ui_touch_target"
            android:layout_height="@dimen/ui_touch_target"
            android:contentDescription="@string/action_open_settings"
            android:src="@drawable/ui_ic_settings"
            app:tint="?attr/termuxActivityDrawerImageTint" />
    </LinearLayout>

    <Button
        android:id="@+id/tmux_sidebar_navigation"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/tmux_sidebar_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tmux_sidebar_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </ScrollView>

    <TextView
        android:id="@+id/tmux_sidebar_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="28dp"
        android:paddingEnd="16dp"
        android:text="@string/ui_tmux_sidebar_empty"
        android:visibility="gone" />

    <View
        android:id="@+id/sidebar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.termux.app.terminal.SessionsListView
        android:id="@+id/terminal_sessions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:longClickable="true"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:saveEnabled="false"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:id="@+id/sidebar_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/new_session_button"
            style="@style/Widget.TermuxPP.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/action_new_session"
            app:icon="@drawable/ui_ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle_keyboard_button"
            style="@style/Widget.TermuxPP.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/action_toggle_soft_keyboard"
            app:icon="@drawable/ui_ic_keyboard" />
    </LinearLayout>
</LinearLayout>
