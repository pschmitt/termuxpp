<?xml version="1.0" encoding="utf-8"?>
<!-- One terminal session. The list sets the activated state on this root for the current session. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/session_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ui_session_bg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_target"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/session_index"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ui_session_badge_bg"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/ui_session_badge_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/session_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TermuxPP.Title"
                android:textColor="@color/ui_session_row_text" />

            <TextView
                android:id="@+id/session_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TermuxPP.Body"
                android:textColor="@color/ui_session_row_text" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/session_tmux_picker"
            style="@style/Widget.TermuxPP.IconButton"
            android:layout_width="@dimen/ui_touch_target"
            android:layout_height="@dimen/ui_touch_target"
            android:contentDescription="@string/ui_tmux_sidebar_picker"
            android:src="@drawable/ui_ic_transcript"
            android:visibility="gone"
            app:tint="?attr/termuxActivityDrawerImageTint" />

        <ImageButton
            android:id="@+id/session_tmux_expand"
            style="@style/Widget.TermuxPP.IconButton"
            android:layout_width="@dimen/ui_touch_target"
            android:layout_height="@dimen/ui_touch_target"
            android:src="@drawable/ui_ic_menu_chevron_down"
            android:visibility="gone"
            app:tint="?attr/termuxActivityDrawerImageTint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/session_tmux_windows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="16dp"
        android:visibility="gone" />
</LinearLayout>
