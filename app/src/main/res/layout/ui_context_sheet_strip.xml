<?xml version="1.0" encoding="utf-8"?>
<!-- The frequent actions of the grouped terminal menu: one row of icon shortcuts that fills the width and
     scrolls sideways once there are more than fit. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/context_strip_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ui_gutter"
    android:layout_marginEnd="@dimen/ui_gutter"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/context_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</HorizontalScrollView>
