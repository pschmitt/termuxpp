<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/boot_script_location"
            android:textAppearance="@style/TextAppearance.TermuxPP.Title"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/boot_script_setup"
            android:textAppearance="@style/TextAppearance.TermuxPP.Body" />

        <TextView
            android:layout_marginTop="16dp"
            android:text="@string/boot_script_example_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TermuxPP.Title" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/ui_code_block_background"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <TextView
                android:text="@string/boot_script_example"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textAppearance="@style/TextAppearance.TermuxPP.Body"
                android:textColor="@color/ui_on_surface"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
