<?xml version="1.0" encoding="utf-8"?>
<!-- Which session the actions act on (with the way to the settings), or the title of a sheet of choices. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/context_header_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ui_sheet_header_icon_bg"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ui_ic_menu_terminal"
        android:tint="?attr/termuxUiOnContainer" />

    <LinearLayout
        android:id="@+id/context_header_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/context_header_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TermuxPP.Title" />

            <TextView
                android:id="@+id/context_header_stopped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_sheet_stopped_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/ui_menu_session_stopped"
                android:textColor="?attr/termuxUiOnContainer"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/context_header_pid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TermuxPP.Body"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/context_header_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TermuxPP.Body"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/context_header_action"
        android:layout_width="@dimen/ui_touch_target"
        android:layout_height="@dimen/ui_touch_target"
        android:layout_marginStart="8dp"
        android:background="@drawable/ui_icon_button_bg"
        android:scaleType="center"
        android:visibility="gone" />
</LinearLayout>
