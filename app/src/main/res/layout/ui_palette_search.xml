<?xml version="1.0" encoding="utf-8"?>
<!-- The search bar of the command palette and of tpp ui picker: the Settings search look, a filled pill
     with a search icon and a clear button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_settings_search_field"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ui_ic_search"
        app:tint="@color/ui_on_surface_variant" />

    <EditText
        android:id="@+id/palette_search_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:imeOptions="actionGo|flagNoExtractUi"
        android:importantForAutofill="noExcludeDescendants"
        android:inputType="textVisiblePassword|textNoSuggestions"
        android:minHeight="52dp"
        android:padding="0dp"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textColor="@color/ui_on_surface"
        android:textColorHint="@color/ui_on_surface_variant"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/palette_search_clear"
        style="@style/Widget.TermuxPP.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/settings_clear_search"
        android:src="@drawable/ui_ic_search_clear"
        android:visibility="invisible"
        app:tint="@color/ui_on_surface_variant" />
</LinearLayout>
