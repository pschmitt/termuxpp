<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:textAppearance="@style/TextAppearance.TermuxPP.Title" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ui_code_block_background"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.TermuxPP.Body"
            android:textColor="@color/ui_on_surface"
            android:textDirection="ltr"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </HorizontalScrollView>
</LinearLayout>
