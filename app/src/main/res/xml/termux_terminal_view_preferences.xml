<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/settings_display">

    <PreferenceCategory app:title="@string/appearance_title">
        <Preference
            app:key="terminal_color_scheme"
            app:icon="@drawable/ui_ic_palette"
            app:title="@string/appearance_colors" />

        <Preference
            app:key="terminal_font"
            app:icon="@drawable/ui_ic_terminal"
            app:title="@string/appearance_font" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="view"
        app:title="@string/termux_terminal_view_view_header">

        <ListPreference
            app:icon="@drawable/ui_ic_palette"
            app:key="app_accent"
            app:title="@string/settings_accent_color"
            app:summary="@string/settings_accent_color_summary"
            app:entries="@array/settings_accent_entries"
            app:entryValues="@array/settings_accent_values"
            app:defaultValue="default"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:icon="@drawable/ui_ic_terminal"
            app:key="terminal_margin_adjustment"
            app:summaryOff="@string/termux_terminal_view_terminal_margin_adjustment_off"
            app:summaryOn="@string/termux_terminal_view_terminal_margin_adjustment_on"
            app:title="@string/termux_terminal_view_terminal_margin_adjustment_title" />

    </PreferenceCategory>

</PreferenceScreen>
