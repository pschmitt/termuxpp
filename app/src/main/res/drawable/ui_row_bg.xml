<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded tonal row inside a full-width list item. The inset provides the gutter and the gap. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/termuxUiRipple">
    <item android:id="@android:id/mask">
        <inset
            android:insetLeft="@dimen/ui_gutter"
            android:insetRight="@dimen/ui_gutter"
            android:insetTop="1dp"
            android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF000000" />
                <corners android:radius="@dimen/ui_row_radius" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="@dimen/ui_gutter"
            android:insetRight="@dimen/ui_gutter"
            android:insetTop="1dp"
            android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/ui_row" />
                <corners android:radius="@dimen/ui_row_radius" />
            </shape>
        </inset>
    </item>
</ripple>
