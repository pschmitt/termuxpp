<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Type scale: native Roboto/system font, sp everywhere so it follows the font scale. -->
    <style name="TextAppearance.TermuxPP.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text_primary</item>
    </style>
    <style name="TextAppearance.TermuxPP.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
    </style>
    <style name="TextAppearance.TermuxPP.Section" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/termuxUiPrimary</item>
    </style>
    <style name="TextAppearance.TermuxPP.SheetItem" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_text_primary</item>
    </style>
    <style name="TextAppearance.TermuxPP.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_on_surface</item>
    </style>
    <style name="TextAppearance.TermuxPP.DrawerTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_on_surface</item>
    </style>

    <style name="TextAppearance.TermuxPP.SettingsHeadline" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_on_surface</item>
    </style>

    <!-- Preference screens use our own rounded-row layouts. -->
    <style name="Preference.TermuxPP" parent="Preference.Material">
        <item name="android:layout">@layout/ui_preference_row</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.TermuxPP.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/ui_preference_category</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.TermuxPP.SwitchCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/ui_preference_row</item>
        <item name="android:widgetLayout">@layout/ui_preference_switch</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.TermuxPP.Switch" parent="Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/ui_preference_row</item>
        <item name="android:widgetLayout">@layout/ui_preference_switch_framework</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.TermuxPP.Dropdown" parent="Preference.DropDown.Material">
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="PreferenceFragment.TermuxPP" parent="PreferenceFragment.Material">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="allowDividerAfterLastItem">false</item>
    </style>
    <style name="PreferenceThemeOverlay.TermuxPP" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceStyle">@style/Preference.TermuxPP</item>
        <item name="preferenceScreenStyle">@style/Preference.TermuxPP</item>
        <item name="dialogPreferenceStyle">@style/Preference.TermuxPP</item>
        <item name="editTextPreferenceStyle">@style/Preference.TermuxPP</item>
        <item name="preferenceCategoryStyle">@style/Preference.TermuxPP.Category</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.TermuxPP.SwitchCompat</item>
        <item name="switchPreferenceStyle">@style/Preference.TermuxPP.Switch</item>
        <item name="dropdownPreferenceStyle">@style/Preference.TermuxPP.Dropdown</item>
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.TermuxPP</item>
        <item name="preferenceFragmentStyle">@style/PreferenceFragment.TermuxPP</item>
        <item name="preferenceCategoryTitleTextColor">?attr/termuxUiPrimary</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.TermuxPP.Section</item>
    </style>

    <!--
      Dialogs: one Material look for every dialog of the app (see DialogUtils): a 28dp surface in the
      row colour, a medium weight headline, muted body text and rounded text buttons in the primary
      colour. The activity themes point alertDialogTheme and materialAlertDialogTheme here, which
      also styles the androidx.preference dialogs.
    -->
    <style name="ThemeOverlay.TermuxPP.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">?attr/termuxUiPrimary</item>
        <item name="colorPrimaryVariant">?attr/termuxUiPrimary</item>
        <item name="colorOnPrimary">?attr/termuxUiOnPrimary</item>
        <item name="colorSecondary">?attr/termuxUiPrimary</item>
        <item name="colorOnSecondary">?attr/termuxUiOnPrimary</item>
        <item name="colorSurface">@color/ui_row</item>
        <item name="colorOnSurface">@color/ui_on_surface</item>
        <item name="colorError">@color/ui_danger</item>
        <item name="android:colorBackground">@color/ui_row</item>
        <item name="android:windowBackground">@drawable/ui_dialog_background</item>
        <item name="android:textColorPrimary">@color/ui_on_surface</item>
        <item name="android:textColorSecondary">@color/ui_on_surface_variant</item>
        <item name="android:textColorLink">?attr/termuxUiPrimary</item>
        <item name="android:textColorAlertDialogListItem">@color/ui_on_surface</item>
        <item name="textColorAlertDialogListItem">@color/ui_on_surface</item>
        <item name="colorControlActivated">?attr/termuxUiPrimary</item>
        <item name="colorControlHighlight">?attr/termuxUiRipple</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TermuxPP.Dialog</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.TermuxPP</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/TermuxPP.Dialog.Title.Panel</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TermuxPP.Dialog.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TermuxPP.Dialog.Message.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.TermuxPP.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.TermuxPP.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.TermuxPP.Button.Dialog</item>
    </style>
    <style name="ShapeAppearance.TermuxPP.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ui_dialog_radius</item>
    </style>
    <style name="MaterialAlertDialog.TermuxPP" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.TermuxPP.Dialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>
    <style name="TermuxPP.Dialog.Title.Panel" parent="@style/MaterialAlertDialog.MaterialComponents.Title.Panel">
        <item name="android:background">@null</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="TermuxPP.Dialog.Title.Text" parent="@style/MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_on_surface</item>
    </style>
    <style name="TermuxPP.Dialog.Message.Text" parent="@style/MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/ui_on_surface_variant</item>
        <item name="android:textColorLink">?attr/termuxUiPrimary</item>
    </style>
    <style name="Widget.TermuxPP.Button.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/termuxUiPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">?attr/termuxUiRipple</item>
    </style>

    <!-- Context menu bottom sheet. -->
    <style name="ThemeOverlay.TermuxPP.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">?attr/termuxUiPrimary</item>
        <item name="colorOnPrimary">?attr/termuxUiOnPrimary</item>
        <item name="colorSecondary">?attr/termuxUiPrimary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/ui_sheet_surface</item>
        <item name="colorOnSurface">@color/ui_on_surface</item>
        <item name="android:colorBackground">@color/ui_sheet_surface</item>
        <item name="android:textColorPrimary">@color/ui_on_surface</item>
        <item name="android:textColorSecondary">@color/ui_on_surface_variant</item>
        <item name="android:navigationBarColor">@color/ui_sheet_surface</item>
        <item name="bottomSheetStyle">@style/Widget.TermuxPP.BottomSheet</item>
    </style>
    <style name="Widget.TermuxPP.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/ui_sheet_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.TermuxPP.Sheet</item>
    </style>
    <style name="ShapeAppearanceOverlay.TermuxPP.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/ui_sheet_radius</item>
        <item name="cornerSizeTopRight">@dimen/ui_sheet_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Drawer buttons. -->
    <style name="Widget.TermuxPP.Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/termuxUiPrimary</item>
        <item name="android:textColor">?attr/termuxUiOnPrimary</item>
        <item name="iconTint">?attr/termuxUiOnPrimary</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">?attr/termuxUiRipple</item>
    </style>
    <style name="Widget.TermuxPP.Button.Tonal" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">?attr/termuxUiContainer</item>
        <item name="android:textColor">?attr/termuxUiOnContainer</item>
        <item name="iconTint">?attr/termuxUiOnContainer</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">?attr/termuxUiRipple</item>
    </style>
    <style name="Widget.TermuxPP.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/ui_icon_button_bg</item>
        <item name="android:minWidth">@dimen/ui_touch_target</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
    </style>
</resources>
