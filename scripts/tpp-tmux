#!/usr/bin/env python3
"""Connect an existing shell SSH wrapper to TermuxPP's experimental tmux UI."""

import argparse
import json
import os
import re
import shlex
import socket
import subprocess
import tempfile
import threading
import uuid


def app_request(terminal, token, windows=None):
    request = ["tmux-windows", terminal, token]
    if windows is not None:
        request.append(windows)
    payload = json.dumps(request, ensure_ascii=False).encode()
    if len(payload) >= 4096:
        raise ValueError("tmux snapshot is too large")
    address = os.environ.get("TPP_SESSION_SOCKET") or "dev.pschmitt.termux.sessions"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect("\0" + address)
        connection.sendall(payload + b"\n")
        with connection.makefile("rb") as response:
            reply = json.loads(response.readline(8192))
    if "error" in reply:
        raise ValueError(reply["error"])
    return reply.get("result")


def remote_client(marker):
    # Identify the exact PTY allocated by ssh::tmux, including after switch-client.
    return f"""ref="${{TMPDIR:-/tmp}}/{marker}/tty"
[ -r "$ref" ] || exit 1
IFS= read -r attached_tty < "$ref" || exit 1
session=$(tmux list-clients -F '#{{client_tty}} #{{session_id}}' |
    awk -v tty="$attached_tty" '$1 == tty {{ print $2; exit }}')
[ -n "$session" ] || exit 1
"""


def remote_command(control_path, script):
    # A missing mux socket must never trigger a second network login.
    return subprocess.run(
        [
            "ssh", "-F", "/dev/null", "-T",
            "-o", "ControlMaster=no", "-o", "ProxyCommand=false",
            "-S", control_path, "termuxpp-mux", "sh -c " + shlex.quote(script),
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=3,
        check=True,
    ).stdout.decode(errors="replace")


def parse_windows(output):
    session, _, rows = output.partition("\n")
    if not re.fullmatch(r"\$[0-9]+", session):
        raise ValueError("Invalid tmux session ID")
    windows = []
    for line in rows.split("\n"):
        row = re.fullmatch(r"(@[0-9]+) ([0-9]+) ([01]) (.*)", line)
        if row is None:
            continue
        window, index, active, title = row.groups()
        windows.append({"id": window, "label": f"{index}  {title[:100]}", "active": active == "1"})
    # Leave room for JSON escaping and the request envelope, even with Unicode titles.
    windows.sort(key=lambda window: not window["active"])
    while len(json.dumps(windows).encode()) > 3650:
        windows.pop()
    windows.sort(key=lambda window: int(window["label"].split()[0]))
    return session, windows


def follow(stop, control_path, marker, terminal, token):
    client = remote_client(marker)
    query = client + """printf '%s\n' "$session"
tmux list-windows -t "$session" -F '#{window_id} #{window_index} #{window_active} #{window_name}'
"""
    try:
        while not stop.is_set():
            try:
                session, windows = parse_windows(remote_command(control_path, query))
                if stop.is_set():
                    break
                selected = app_request(terminal, token, windows)
                if isinstance(selected, str) and any(w["id"] == selected for w in windows):
                    remote_command(control_path, client + f"""[ "$session" = '{session}' ] || exit 1
tmux select-window -t "$session:{selected}"
""")
            except (OSError, ValueError, subprocess.SubprocessError):
                # The terminal remains usable during SSH startup and app or network failure.
                pass
            stop.wait(0.75)
    finally:
        try:
            app_request(terminal, token)
        except (OSError, ValueError):
            pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("remote_script", help="complete remote shell command for the visible tmux attachment")
    parser.add_argument("ssh_args", nargs=argparse.REMAINDER, help="SSH options and destination, following --")
    args = parser.parse_args()
    if not args.ssh_args:
        parser.error("expected SSH options and destination")
    ssh_args = ["ssh", *args.ssh_args]
    original_command = "sh -c " + shlex.quote(args.remote_script)
    terminal = os.environ.get("TPP_TERMINAL_SESSION_ID")
    token = uuid.uuid4().hex
    try:
        if not terminal:
            raise ValueError("No TermuxPP terminal ID")
        app_request(terminal, token)
        directory = tempfile.TemporaryDirectory(prefix="tppm-")
    except (OSError, ValueError):
        os.execvp("ssh", [*ssh_args, original_command])

    marker = f".tpp-tmux-{token}"
    # The visible command runs normally even if the remote marker cannot be created.
    remote = f"""umask_saved=$(umask)
umask 077
ref="${{TMPDIR:-/tmp}}/{marker}"
if mkdir -- "$ref" 2>/dev/null
then
  trap 'rm -f -- "$ref/tty"; rmdir -- "$ref"' EXIT
  trap 'exit 129' HUP
  trap 'exit 143' TERM
  tty > "$ref/tty"
fi
umask "$umask_saved"
(
{args.remote_script}
)
"""
    with directory as path:
        control_path = os.path.join(path, "s")
        # OpenSSH adds a random suffix while creating the master socket.
        if len(os.fsencode(control_path)) + 17 >= 108:
            return subprocess.call([*ssh_args, original_command])
        stop = threading.Event()
        follower = threading.Thread(target=follow, args=(stop, control_path, marker, terminal, token))
        try:
            follower.start()
            return subprocess.call([
                "ssh", "-o", "ControlMaster=yes", "-o", "ControlPersist=no",
                "-o", f"ControlPath={control_path}", *ssh_args[1:], "sh -c " + shlex.quote(remote),
            ])
        except KeyboardInterrupt:
            return 130
        finally:
            stop.set()
            follower.join()


if __name__ == "__main__":
    raise SystemExit(main())
